# DATA_CIRCULAR API - Variables de Entorno de Ejemplo
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/data_circular_dev?schema=public"

# Seguridad y Tokens
# Genera secretos aleatorios de al menos 32 bytes. Los valores de ejemplo son rechazados al arrancar.
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_aleatorios
# Vidas útiles cortas: access 15 minutos, refresh 7 días con rotación y revocación en servidor.
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tu_clave_secreta_refresh_jwt_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Seeds de demostración (solo desarrollo; el script se niega a ejecutarse en producción)
ALLOW_DEMO_SEED=false
EVAL_ADMIN_EMAIL=
EVAL_ADMIN_PASSWORD=
EVAL_ADMIN_FULL_NAME=
EVAL_ADMIN_PHONE=

# Bootstrap del administrador inicial (un solo uso)
# Solo se ejecuta con ALLOW_ADMIN_BOOTSTRAP=true y falla si ya existe un ADMIN.
# Define las credenciales por variables de entorno o déjalas vacías para entrada interactiva.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=
ADMIN_BOOTSTRAP_PHONE=

# CORS
CORS_ORIGIN="http://localhost:8081,http://localhost:19006,http://localhost:3000"

# Fundación IMARA - Política de Datos
# En producción, configurar una URL pública HTTPS y una versión publicada.
DATA_POLICY_URL=
DATA_POLICY_VERSION=pendiente

# Términos de uso y derechos del titular (Grupo 4)
TERMS_VERSION=2026.11.17
REQUIRE_TERMS_ACCEPTANCE=false
ACCOUNT_DELETION_RETENTION_DAYS=30
ACCOUNT_DELETION_RETENTION_NOTICE=Al eliminar tu cuenta se anonimizan tus datos y se conservan los registros mínimos de auditoría y obligaciones legales durante el periodo configurado.
SIMULATED_PASSWORD_RECOVERY_ENABLED=false
SAMPLE_CERTIFICATES_ENABLED=false
PURGE_SCHEDULER_ENABLED=false
PURGE_INTERVAL_HOURS=24
