# DATA_CIRCULAR - Variables de Entorno de Ejemplo
# IMPORTANTE: Copia este archivo a .env en apps/api o en la raíz para desarrollo local.
# NUNCA agregues contraseñas reales ni secretos en este archivo de ejemplo.

# Entorno de ejecución: development | test | production
NODE_ENV=development
PORT=3000

# Docker Compose - OBLIGATORIAS, sin valores por defecto
# Docker Compose falla si estas variables no están definidas en el .env local.
# Genera la contraseña con un gestor de secretos o con: openssl rand -base64 32
# No uses "postgres" ni contraseñas de ejemplo.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Conexión a Base de Datos PostgreSQL
# Formato: postgresql://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DATABASE>?schema=public
DATABASE_URL=postgresql://USUARIO:CONTRASENA@127.0.0.1:5432/DATABASE?schema=public

# Seguridad y Autenticación JWT (para Fases siguientes)
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=GENERA_OTRO_SECRETO_ALEATORIO_DISTINTO_DE_AL_MENOS_32_BYTES
JWT_REFRESH_EXPIRES_IN=30d

# Configuración de CORS
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Política de Privacidad de Datos (Fundación IMARA)
DATA_POLICY_URL=
DATA_POLICY_VERSION=pendiente
